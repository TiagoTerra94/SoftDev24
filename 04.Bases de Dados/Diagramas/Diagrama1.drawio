        <mxCell id="P2qQa0A1AkyzurKAFvBY-2" value="Livro" style="whiteSpace=wrap;html=1;align=center;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;" vertex="1" parent="1">
